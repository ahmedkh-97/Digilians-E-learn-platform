      "question": "What does EXISTS check according to the session?",
      "options": [
        {
          "id": "A",
          "text": "Whether every value is greater than every other value."
        },
        {
          "id": "B",
          "text": "Whether a subquery returns any rows."
        },
        {
          "id": "C",
          "text": "Whether a string contains a wildcard."
        },
        {
